#pragma code_page(65001)
#include <windows.h>

1 24 "app.manifest"

101 DIALOGEX 0, 0, 280, 167
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "新增指令"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT          "指令", 110, 10, 11, 42, 10
    COMBOBOX       111, 54, 8, 216, 100, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT          "按钮名称", -1, 10, 30, 42, 12
    EDITTEXT       112, 54, 27, 216, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT          "发送格式", -1, 10, 50, 42, 10
    COMBOBOX       113, 54, 47, 62, 64, CBS_DROPDOWNLIST | WS_TABSTOP
    COMBOBOX       114, 124, 47, 68, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    EDITTEXT       115, 10, 67, 260, 56, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    LTEXT          "", 116, 10, 128, 260, 11, SS_ENDELLIPSIS
    PUSHBUTTON     "删除指令", 117, 10, 143, 56, 15
    DEFPUSHBUTTON  "保存", IDOK, 152, 143, 56, 15
    PUSHBUTTON     "取消", IDCANCEL, 214, 143, 56, 15
END

102 DIALOGEX 0, 0, 440, 193
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_COMPOSITED
CAPTION "N6 串口升级"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT          "请先在主窗口打开串口 · 升级日志显示在主窗口", 118, 10, 12, 420, 13
    LTEXT          "进入方式", -1, 10, 37, 50, 12
    COMBOBOX       102, 64, 34, 366, 90, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT          "升级目标", -1, 10, 61, 50, 12
    COMBOBOX       103, 64, 58, 366, 90, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT          "AppS 镜像", -1, 10, 85, 50, 12
    EDITTEXT       104, 64, 82, 306, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON     "浏览…", 105, 378, 81, 52, 17
    LTEXT          "AppNS 镜像", -1, 10, 109, 50, 12
    EDITTEXT       106, 64, 106, 306, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON     "浏览…", 107, 378, 105, 52, 17
    PUSHBUTTON     "开始升级", 108, 10, 132, 72, 20
    PUSHBUTTON     "停止", 110, 90, 132, 62, 20
    CONTROL        "", 112, "msctls_progress32", WS_VISIBLE, 10, 161, 420, 8
    LTEXT          "选择镜像后开始升级 · 115200 / 8N1 / YMODEM", 113, 10, 176, 420, 13, SS_ENDELLIPSIS
END
